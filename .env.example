# Required: Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server config
PORT=3000

# Optional: API key for protecting your endpoints (set this in production)
# Clients must send this as: Authorization: Bearer <key>
API_SECRET_KEY=

# Future (Option B): Google Maps API key for business search
# GOOGLE_MAPS_API_KEY=
